#!/bin/sh
set -eu
set -f

CONFIG_NAME="campus-direct-android"
CONFIG_SECTION="main"

json_error() {
    printf '{"ok":false,"error":"%s"}\n' "$1"
    exit 1
}

valid_octet() {
    value="$1"
    case "$value" in
        ''|*[!0-9]*) return 1 ;;
        0) return 0 ;;
        0*) return 1 ;;
    esac
    [ "$value" -le 255 ]
}

valid_ipv4() {
    address="$1"
    old_ifs="$IFS"
    IFS='.'
    set -- $address
    IFS="$old_ifs"
    [ "$#" -eq 4 ] || return 1
    valid_octet "$1" && valid_octet "$2" && valid_octet "$3" && valid_octet "$4"
}

ipv4_to_int() {
    address="$1"
    old_ifs="$IFS"
    IFS='.'
    set -- $address
    IFS="$old_ifs"
    printf '%s\n' "$(( $1 * 16777216 + $2 * 65536 + $3 * 256 + $4 ))"
}

in_cidr() {
    address="$1"
    cidr="$2"
    network="${cidr%/*}"
    prefix="${cidr#*/}"
    valid_ipv4 "$address" || return 1
    valid_ipv4 "$network" || return 1
    case "$prefix" in ''|*[!0-9]*) return 1 ;; esac
    [ "$prefix" -ge 0 ] && [ "$prefix" -le 32 ] || return 1
    address_int="$(ipv4_to_int "$address")"
    network_int="$(ipv4_to_int "$network")"
    if [ "$prefix" -eq 0 ]; then
        mask=0
    else
        mask="$(( (4294967295 << (32 - prefix)) & 4294967295 ))"
    fi
    [ "$(( address_int & mask ))" -eq "$(( network_int & mask ))" ]
}

uci_value() {
    uci -q get "${CONFIG_NAME}.${CONFIG_SECTION}.$1" 2>/dev/null || true
}

load_config() {
    expected_cidr="$(uci_value expected_cidr)"
    expected_gateway="$(uci_value expected_gateway)"
    route_protocol="$(uci_value route_protocol)"
    state_file="$(uci_value state_file)"
    lock_dir="$(uci_value lock_dir)"

    [ -n "$expected_cidr" ] || json_error "missing_expected_cidr"
    [ -n "$expected_gateway" ] || json_error "missing_expected_gateway"
    valid_ipv4 "$expected_gateway" || json_error "invalid_expected_gateway"
    in_cidr "$expected_gateway" "$expected_cidr" || json_error "gateway_outside_expected_cidr"
    case "$route_protocol" in ''|*[!0-9]*) json_error "invalid_route_protocol" ;; esac
    [ "$route_protocol" -ge 1 ] && [ "$route_protocol" -le 255 ] || json_error "invalid_route_protocol"
    case "$state_file" in /*) ;; *) json_error "invalid_state_file" ;; esac
    case "$lock_dir" in /tmp/*) ;; *) json_error "invalid_lock_dir" ;; esac
}

load_wan() {
    wan_json="$(ubus call network.interface.wan status 2>/dev/null)" || json_error "wan_status_unavailable"
    wan_device="$(printf '%s' "$wan_json" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
    [ -n "$wan_device" ] || wan_device="$(printf '%s' "$wan_json" | jsonfilter -e '@.device' 2>/dev/null || true)"
    case "$wan_device" in ''|*[!A-Za-z0-9_.:@-]*) json_error "invalid_wan_device" ;; esac

    wan_ip="$(ip -4 -o addr show dev "$wan_device" scope global 2>/dev/null | awk 'NR==1 { split($4,a,"/"); print a[1] }')"
    wan_gateway="$(ip -4 route show default dev "$wan_device" 2>/dev/null | awk 'NR==1 { for (i=1;i<=NF;i++) if ($i=="via") { print $(i+1); exit } }')"
    valid_ipv4 "$wan_ip" || json_error "invalid_wan_ipv4"
    valid_ipv4 "$wan_gateway" || json_error "invalid_wan_gateway"
    in_cidr "$wan_ip" "$expected_cidr" || json_error "wan_ipv4_outside_expected_cidr"
    [ "$wan_gateway" = "$expected_gateway" ] || json_error "unexpected_gateway"
}

managed_peer() {
    [ -f "$state_file" ] || return 0
    peer="$(sed -n '1p' "$state_file" 2>/dev/null || true)"
    valid_ipv4 "$peer" && printf '%s' "$peer"
}

route_line() {
    ip -4 route show exact "$1/32" 2>/dev/null | sed -n '1p'
}

route_is_managed() {
    line="$1"
    printf '%s\n' "$line" | grep -Eq "(^| )proto ${route_protocol}( |$)"
}

route_is_expected() {
    line="$1"
    route_is_managed "$line" &&
        printf '%s\n' "$line" | grep -Fq " via ${wan_gateway} " &&
        printf '%s\n' "$line" | grep -Eq "(^| )dev ${wan_device}( |$)"
}

write_state() {
    peer="$1"
    umask 077
    temp_file="${state_file}.tmp.$$"
    printf '%s\n' "$peer" > "$temp_file"
    mv -f "$temp_file" "$state_file"
}

acquire_lock() {
    if ! mkdir "$lock_dir" 2>/dev/null; then
        json_error "operation_in_progress"
    fi
    trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT HUP INT TERM
}

validate_peer() {
    peer="$1"
    valid_ipv4 "$peer" || json_error "invalid_peer_ipv4"
    in_cidr "$peer" "$expected_cidr" || json_error "peer_outside_expected_cidr"
    [ "$peer" != "$expected_gateway" ] || json_error "peer_equals_gateway"
    [ "$peer" != "$wan_ip" ] || json_error "peer_equals_wan_ipv4"
}

do_status() {
    load_wan
    peer="$(managed_peer)"
    present=false
    if [ -n "$peer" ]; then
        line="$(route_line "$peer")"
        if [ -n "$line" ] && route_is_expected "$line"; then present=true; fi
    fi
    printf '{"ok":true,"action":"status","wan_ip":"%s","gateway":"%s","device":"%s","managed_peer":"%s","route_present":%s}\n' \
        "$wan_ip" "$wan_gateway" "$wan_device" "$peer" "$present"
}

do_apply() {
    [ "$#" -eq 1 ] || json_error "invalid_argument_count"
    acquire_lock
    load_wan
    peer="$1"
    validate_peer "$peer"
    line="$(route_line "$peer")"
    if [ -n "$line" ] && ! route_is_managed "$line"; then json_error "conflicting_unmanaged_route_exists"; fi
    action=unchanged
    if [ -z "$line" ] || ! route_is_expected "$line"; then
        ip -4 route replace "$peer/32" via "$wan_gateway" dev "$wan_device" proto "$route_protocol" metric 1 || json_error "route_apply_failed"
        line="$(route_line "$peer")"
        route_is_expected "$line" || json_error "route_verification_failed"
        ip -4 neigh del "$peer" dev "$wan_device" 2>/dev/null || true
        action=applied
    fi
    write_state "$peer"
    printf '{"ok":true,"action":"%s","peer":"%s","changed":%s}\n' "$action" "$peer" "$([ "$action" = applied ] && printf true || printf false)"
}

do_verify() {
    [ "$#" -eq 1 ] || json_error "invalid_argument_count"
    load_wan
    peer="$1"
    validate_peer "$peer"
    line="$(route_line "$peer")"
    [ -n "$line" ] && route_is_expected "$line" || json_error "managed_route_missing"
    if ping -c 3 -W 2 "$peer" >/dev/null 2>&1; then
        printf '{"ok":true,"action":"verify","reachable":true}\n'
        exit 0
    fi
    printf '{"ok":true,"action":"verify","reachable":false}\n'
}

do_cleanup() {
    [ "$#" -eq 1 ] || json_error "invalid_argument_count"
    acquire_lock
    load_wan
    peer="$1"
    validate_peer "$peer"
    recorded="$(managed_peer)"
    [ -z "$recorded" ] || [ "$recorded" = "$peer" ] || json_error "peer_not_owned_by_android_helper"
    line="$(route_line "$peer")"
    removed=false
    if [ -n "$line" ]; then
        route_is_managed "$line" || json_error "conflicting_unmanaged_route_exists"
        ip -4 route del "$peer/32" proto "$route_protocol" || json_error "route_cleanup_failed"
        [ -z "$(route_line "$peer")" ] || json_error "route_cleanup_failed"
        removed=true
    fi
    rm -f "$state_file"
    printf '{"ok":true,"action":"removed","removed":%s,"peer":"%s"}\n' "$removed" "$peer"
}

load_config
command_name="${1:-status}"
if [ "$#" -gt 0 ]; then shift; fi
case "$command_name" in
    status|inspect) [ "$#" -eq 0 ] || json_error "invalid_argument_count"; do_status ;;
    apply) do_apply "$@" ;;
    verify) do_verify "$@" ;;
    cleanup) do_cleanup "$@" ;;
    *) json_error "unknown_command" ;;
esac
